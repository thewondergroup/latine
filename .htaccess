# Latine Mayfair – static site on Krystal (Apache)
DirectoryIndex index.html index.php
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# HTTPS and no www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://latinemayfair.com%{REQUEST_URI} [L,R=301]

# Never show .html in the address bar
# /page/index.html  ->  /page/
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^ /%1 [L,R=301]
# /page.html  ->  /page/   (when that folder exists)
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
RewriteCond %{DOCUMENT_ROOT}/%1/index.html -f
RewriteRule ^ /%1/ [L,R=301]
# Add the trailing slash to folder pages
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [L,R=301]

# Old WordPress addresses
RewriteRule ^main-home/?$ / [L,R=301]
RewriteRule ^lucky-7/?$ / [L,R=301]
RewriteRule ^journal/?$ /press/ [L,R=301]
RewriteRule ^team/?$ /about-us/ [L,R=301]
RewriteRule ^luxury-dishes-of-french-region/?$ / [L,R=301]
RewriteRule ^(category|tag|author|feed|comments)(/.*)?$ / [L,R=301]
</IfModule>

# Speed: compression and caching
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType video/mp4 "access plus 30 days"
</IfModule>
